<Window x:Class="ClaudeTokenManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Token Manager" Width="640" Height="420" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">
        <Border x:Name="ImportBanner" DockPanel.Dock="Top" Visibility="Collapsed"
                Background="#FFF4E5" BorderBrush="#E0B070" BorderThickness="1" Padding="8" Margin="0,0,0,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Save as profile..." Click="Import_Click" Margin="8,0,0,0" />
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="settings.json has a token that isn't in your library yet." />
            </DockPanel>
        </Border>

        <TextBlock x:Name="ActiveText" DockPanel.Dock="Top" Margin="0,0,0,8" FontWeight="SemiBold" />

        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" VerticalAlignment="Center"
                      Content="Start with Windows" Checked="Startup_Changed" Unchecked="Startup_Changed" />
            <StackPanel Orientation="Horizontal">
                <Button Content="Add..." Click="Add_Click" />
                <Button x:Name="EditButton" Content="Edit..." Click="Edit_Click" />
                <Button x:Name="DeleteButton" Content="Delete" Click="Delete_Click" />
                <Button x:Name="CopyButton" Content="Copy token" Click="Copy_Click" />
                <Button x:Name="ActivateButton" Content="Use this token" Click="Activate_Click" FontWeight="SemiBold" />
            </StackPanel>
        </DockPanel>

        <ListView x:Name="ProfileList" SelectionMode="Single"
                  SelectionChanged="ProfileList_SelectionChanged" MouseDoubleClick="ProfileList_DoubleClick">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="" Width="28" DisplayMemberBinding="{Binding ActiveMark}" />
                    <GridViewColumn Header="Name" Width="170" DisplayMemberBinding="{Binding Name}" />
                    <GridViewColumn Header="Token" Width="120" DisplayMemberBinding="{Binding Hint}" />
                    <GridViewColumn Header="Notes" Width="270" DisplayMemberBinding="{Binding Notes}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
