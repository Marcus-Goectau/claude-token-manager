<Window x:Class="ClaudeTokenManager.ProfileEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="14">
        <TextBlock Text="Name" />
        <TextBox x:Name="NameBox" Margin="0,2,0,10" Padding="2" />

        <TextBlock x:Name="TokenLabel" Text="API token" />
        <Grid Margin="0,2,0,4">
            <PasswordBox x:Name="TokenPassword" Padding="2" />
            <TextBox x:Name="TokenText" Padding="2" Visibility="Collapsed" />
        </Grid>
        <CheckBox x:Name="ShowCheck" Content="Show token" Margin="0,0,0,10"
                  Checked="Show_Changed" Unchecked="Show_Changed" />

        <TextBlock Text="Notes (optional)" />
        <TextBox x:Name="NotesBox" Margin="0,2,0,14" Padding="2" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" IsDefault="True" Click="Save_Click" />
            <Button Content="Cancel" IsCancel="True" Margin="0" />
        </StackPanel>
    </StackPanel>
</Window>
